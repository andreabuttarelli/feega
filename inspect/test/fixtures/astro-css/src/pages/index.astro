---
const title = 'Northwind';
const beans = [
  { name: 'Huila Washed', note: 'Red apple, panela · clean and round', price: '€14' },
  { name: 'Nyeri AA', note: 'Blackcurrant, grapefruit, bright', price: '€18' }
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
  </head>
  <body>
    <main>
    <h1>Plan your launch in an afternoon</h1>
    <p>Briefs, timelines and assets in one place.</p>
    <p>Your whole team can edit.</p>
    <section class="beans">
      {beans.map((bean) => (
        <article class="card">
          <h3>{bean.name}</h3>
          <p>{bean.note}</p>
          <a href="#buy">Add to bag · {bean.price}</a>
        </article>
      ))}
    </section>
    </main>
  </body>
</html>

<style>
  main {
    max-width: 40rem;
    margin: 4rem auto;
  }

  h1 {
    font-size: 3rem;
    color: #111;
  }
</style>
