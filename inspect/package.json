{
  "name": "feega-inspect",
  "displayName": "Feega Inspect",
  "description": "Click an element of your running web app and edit its design: the change is written to your source as a Tailwind class or your own token.",
  "version": "0.1.0",
  "publisher": "AndreaButtarelli",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/andreabuttarelli/feega",
    "directory": "inspect"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "feegaInspect.open",
        "title": "Open the running app",
        "category": "Feega Inspect"
      },
      {
        "command": "feegaInspect.designFolder",
        "title": "Design this folder with Feega",
        "category": "Feega Inspect"
      },
      {
        "command": "feegaInspect.designPage",
        "title": "Design this page with Feega",
        "category": "Feega Inspect"
      }
    ],
    "configuration": {
      "title": "Feega Inspect",
      "properties": {
        "feegaInspect.telemetry": {
          "type": "boolean",
          "default": true,
          "description": "Send anonymous usage counts (opens, edits, framework, styling system). No code, no paths. Also off when VS Code telemetry is off."
        },
        "feegaInspect.styling": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "tailwind",
            "css"
          ],
          "description": "How style edits are written. Auto: Tailwind classes when the project has Tailwind; otherwise CSS in the component style block (Svelte, Vue), or an inline style in files without a stylesheet (JSX, HTML)."
        },
        "feegaInspect.devCommand": {
          "type": "string",
          "default": "",
          "description": "Command that starts the dev server. Empty: detected from package.json."
        },
        "feegaInspect.defaultSize": {
          "type": "string",
          "default": "full",
          "enum": [
            "full",
            "desktop",
            "tablet",
            "phone"
          ],
          "description": "Device size the preview opens at."
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "feegaInspect.designFolder",
          "when": "explorerResourceIsFolder",
          "group": "navigation@90"
        },
        {
          "command": "feegaInspect.designPage",
          "when": "!explorerResourceIsFolder && resourceExtname =~ /^\\.(svelte|vue|tsx|jsx|astro|html)$/",
          "group": "navigation@90"
        }
      ],
      "commandPalette": [
        {
          "command": "feegaInspect.designFolder",
          "when": "false"
        },
        {
          "command": "feegaInspect.designPage",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "dev": "node build.mjs --watch",
    "build": "node build.mjs",
    "package": "npm run build && npx -y @vscode/vsce package --no-dependencies --allow-missing-repository --skip-license",
    "test:e2e": "npm run build && node test/run.cjs"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.4.1"
  }
}
