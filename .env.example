# feega environment.
#
# `npm run setup` fills the REQUIRED block for you when a local Supabase is running
# (supabase start, or docker compose up from infra/compose). Everything below it is OPTIONAL:
# the canvas (design and motion editing, in-browser export) works with the REQUIRED block alone.
# An optional feature whose key is missing says so in the app ("Add <KEY> to .env to enable ...")
# instead of failing.


# ══ REQUIRED ═══════════════════════════════════════════════════════════════════════════════════

# Your Supabase API (supabase start prints it; the compose stack serves it on :8000).
PUBLIC_SUPABASE_URL=
# anon / publishable key. Public by design, but point it at YOUR project.
PUBLIC_SUPABASE_ANON_KEY=
# service_role key. Server only, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Origin the app is served from, no trailing slash. Used for links the server builds without a request.
PUBLIC_APP_URL=http://localhost:5173

# Signs and seals tokens and stored secrets. Any long random string: openssl rand -hex 32
APP_SECRET=

# Direct Postgres URL. Only `npm run setup`, `db:migrate` and `db:seed` read it; the app talks through Supabase.
DATABASE_URL=


# ══ SELF-HOST DEFAULTS ═════════════════════════════════════════════════════════════════════════

# open = nothing is credit-gated or plan-gated. Leave it on for a self-hosted instance.
BILLING_PROVIDER=open

# adapter-node only (npm run start, the compose image): the origin the server believes it serves.
# Same value as PUBLIC_APP_URL. Leave the line commented for `npm run dev`; an empty value refuses to boot.
# ORIGIN=http://localhost:3000


# ══ OPTIONAL: AI agent and text generation ═════════════════════════════════════════════════════
# Without LLM_API_KEY the chat agent and every text step say "Add LLM_API_KEY to .env to enable ...".

# OpenAI-compatible gateway. OpenRouter by default.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_DEFAULT_MODEL=google/gemini-2.5-flash
# Comma-separated picker list. First = fast, second = pro.
LLM_MODELS=google/gemini-2.5-flash,google/gemini-2.5-pro
# Embeddings. Must output 768 dimensions.
EMBEDDING_MODEL=google/gemini-embedding-001
# Model that writes component code in the motion agent.
# LLM_CODE_MODEL=anthropic/claude-sonnet-5.5
# QC video/audio reviewer model.
# LLM_VIDEO_REVIEWER_MODEL=google/gemini-2.5-flash
# low | medium | high: how hard the reviewers think.
# GEMINI_JUDGE_THINKING_LEVEL=high
# Default chat tier when the client sends none: auto | fast | pro.
# CHAT_TIER=fast
# Moderation screen in front of every generation (Jev). Empty = the LLM judge decides alone.
JEV_API_KEY=
# JEV_BASE_URL=https://api.typesafe.ai/v1
# Re-ranks canvas next-step suggestions. Empty = rules only.
TYPESAFE_API_KEY=


# ══ OPTIONAL: image, video, audio and 3D generation ════════════════════════════════════════════
# Each provider you add shows its models in the picker after the model catalogue syncs
# (curl http://localhost:5173/api/v1/ai-models/sync once, with `npm run dev`).

OPENROUTER_API_KEY=
WIRO_API_KEY=
WIRO_API_SECRET=
# WIRO_BASE_URL=https://api.wiro.ai/v1
KIE_API_KEY=
# KIE_BASE_URL=https://api.kie.ai/api/v1
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
# HIGGSFIELD_BASE_URL=https://api.higgsfield.ai
# Voices and voice-over.
ELEVENLABS_API_KEY=
# AI_ROUTE_IMAGE=nano-banana
# AI_ROUTE_TTS=gemini-tts


# ══ OPTIONAL: agent web access ═════════════════════════════════════════════════════════════════

# Web search for the agent. Empty = OpenRouter's web plugin.
EXA_API_KEY=
# Hosted Chrome for sites that block bots, and the agent's browse tool.
BROWSERLESS_API_KEY=
# BROWSERLESS_BASE_URL=https://production-sfo.browserless.io


# ══ OPTIONAL: render farm and media tools ══════════════════════════════════════════════════════
# Browser export needs none of these. They serve server-side renders (MP4 from the agent, API and MCP).

# Remote renderer. Defaults to the hosted feega farm; point it at your own or leave unused.
# REMOTE_RENDER_URL=
# Use an ffmpeg you already have instead of downloading one.
# FFMPEG_BIN=
# Chrome/Chromium for server-side image export. Found automatically on macOS/Linux; set it if not.
# CHROMIUM_PATH=
# Extra flags, e.g. --no-sandbox inside a container (the app image sets it).
# CHROMIUM_ARGS=


# ══ OPTIONAL: paid plans (Stripe) ══════════════════════════════════════════════════════════════
# Not needed with BILLING_PROVIDER=open.

STRIPE_SECRET_KEY=
# STRIPE_PORTAL_CONFIGURATION=
# STRIPE_RETENTION_COUPON=


# ══ OPTIONAL: email ════════════════════════════════════════════════════════════════════════════
# Invites and transactional mail. Auth mail (sign-up confirmation) comes from Supabase Auth.

RESEND_API_KEY=
# EMAIL_FROM=feega <noreply@your-domain>
# EMAIL_DOMAIN=your-domain


# ══ OPTIONAL: monitoring and analytics ═════════════════════════════════════════════════════════
# All off when empty. Use your own projects, never ours.

# Sentry, production builds only.
PUBLIC_SENTRY_DSN=
PUBLIC_POSTHOG_KEY=
PUBLIC_CLARITY_ID=
PUBLIC_SELINE_TOKEN=
PUBLIC_META_PIXEL_ID=


# ══ OPTIONAL: scheduled jobs ═══════════════════════════════════════════════════════════════════
# Production builds refuse every cron endpoint without this. `npm run dev` skips the check.
# Call /api/v1/... endpoints listed under `crons` in vercel.json with: Authorization: Bearer $CRON_SECRET

CRON_SECRET=


# ══ OPTIONAL: content credentials ══════════════════════════════════════════════════════════════
# C2PA signing of generated images and video. Unsigned output ships fine without it.
# C2PA_SIGNING=on
C2PA_CERT=
C2PA_KEY=


# ══ OPTIONAL: staff lists ══════════════════════════════════════════════════════════════════════
# Comma-separated emails that get internal-only affordances. Empty = nobody.
INTERNAL_EMAILS=
