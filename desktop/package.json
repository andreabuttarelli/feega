{
  "name": "feega-desktop",
  "productName": "Feega",
  "description": "Design in your codebase",
  "author": "Feega",
  "homepage": "https://feega.app",
  "private": true,
  "version": "0.1.0",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "icons": "electron scripts/make-icons.cjs",
    "dev": "node scripts/dev-identity.mjs && node build.mjs && electron .",
    "start": "node scripts/dev-identity.mjs && node build.mjs && electron ."
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "app.feega.desktop",
    "productName": "Feega",
    "copyright": "Copyright 2026 Feega",
    "files": [
      "dist/**",
      "build/icons/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../npx/dist",
        "to": "npx"
      }
    ],
    "directories": {
      "buildResources": "build/icons"
    },
    "mac": {
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true
    },
    "win": {
      "icon": "build/icons/icon.ico"
    },
    "linux": {
      "icon": "build/icons",
      "category": "Development",
      "mimeTypes": [
        "x-scheme-handler/feega"
      ]
    },
    "protocols": [
      {
        "name": "Feega",
        "schemes": [
          "feega"
        ]
      }
    ]
  }
}
