# LOCAL DEMO VALUES for `docker compose up` in this directory: the Supabase stack plus the app.
# Every secret below is public (it is in this repo). That is fine for a machine only you can reach,
# because every published port is bound to 127.0.0.1. Before this stack is reachable by anyone else,
# replace ALL of them: POSTGRES_PASSWORD, JWT_SECRET with matching ANON_KEY / SERVICE_ROLE_KEY,
# SECRET_KEY_BASE, DASHBOARD_PASSWORD, APP_SECRET, SEED_DEMO_PASSWORD.
#
# Keep your own values out of version control:
#   docker compose --env-file .env --env-file mine.env up
# The app's full env reference is ../../.env.example; only what this compose passes lives here.

# ── Postgres ──────────────────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=feega-local-postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ── Auth tokens ───────────────────────────────────────────────────────────────────────────────
# JWT_SECRET + ANON_KEY + SERVICE_ROLE_KEY are ONE SET: the two keys below are JWTs signed with
# this exact secret (Supabase's published demo secret, same as the official compose). Change the
# secret without regenerating the keys and every service answers 401 JWSInvalidSignature to
# everything — including the very first request. To change them, change them together:
# `sh utils/generate-keys.sh` (supabase/supabase) takes JWT_SECRET and prints the matching keys.
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

# ANON_KEY / SERVICE_ROLE_KEY: the values below are Supabase's own published "demo" JWTs (signed
# with the well-known demo secret, documented at supabase.com/docs/guides/self-hosting) — the same
# ones the official compose ships. They are safe to start with on a machine only you can reach,
# but they are PUBLIC and known to everyone who has ever read Supabase's docs: mint your own with
# `sh utils/generate-keys.sh` from the supabase/supabase repo (or any HS256 JWT signer) before this
# instance is reachable by anyone else, and put PUBLIC_SUPABASE_ANON_KEY (../../.env) in sync.
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q
# Opaque "sb_publishable_…" / "sb_secret_…" key pair — optional, leave blank to stick with the
# legacy JWT keys above. See supabase.com/docs/guides/self-hosting/self-hosted-auth-keys.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# Dashboard basic-auth (Kong's own login prompt in front of Studio) — only used with --profile studio.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=feega-local-dashboard

# Encryption key Realtime uses for its internal channel state. Must be 64+ chars.
SECRET_KEY_BASE=feega-local-realtime-secret-key-base-0123456789abcdef0123456789abcdef0123456789
# Encryption key for the `_realtime` schema's sensitive fields. Must be exactly 16 chars.
REALTIME_DB_ENC_KEY=supabaserealtime

# ── URLs ──────────────────────────────────────────────────────────────────────────────────────
# What Kong listens on / what browsers hit. localhost is fine for local dev; set your real
# domain once this is behind a reverse proxy.
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000/auth/v1
KONG_HTTP_PORT=8000
STUDIO_PORT=54323

# Where Auth sends browsers back to after email links / OAuth — your app's own dev/prod URL,
# same value as PUBLIC_APP_URL in the app's .env.
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=

# ── Auth behaviour ────────────────────────────────────────────────────────────────────────────
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
# On (unlike upstream's default): no SMTP is configured below, so without this every self-host
# signup would be stuck waiting on a confirmation email nobody can send yet. Turn this off once
# SMTP_* is filled in and you want real email confirmation.
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
# Optional — only needed if you want GoTrue to actually send confirmation/invite/reset emails.
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=2500
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=

# ── PostgREST ─────────────────────────────────────────────────────────────────────────────────
PGRST_DB_SCHEMAS=public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

# ── Storage ───────────────────────────────────────────────────────────────────────────────────
STORAGE_TENANT_ID=stub

# ── Studio (--profile studio only) ───────────────────────────────────────────────────────────
STUDIO_DEFAULT_ORGANIZATION=feega self-host
STUDIO_DEFAULT_PROJECT=Default Project

# ── App (`app` service) ──────────────────────────────────────────────────────────────────────
# ANON_KEY / SERVICE_ROLE_KEY above are passed to the container as PUBLIC_SUPABASE_ANON_KEY /
# SUPABASE_SERVICE_ROLE_KEY, and the app reaches the stack in-network at http://kong:8000 unless
# you override PUBLIC_SUPABASE_URL. The rest is the minimum worth setting by hand:
APP_PORT=3000
PUBLIC_APP_URL=http://localhost:3000
APP_SECRET=feega-local-app-secret-change-me-0123456789
# Text gateway (agent chat, JSON, embeddings, judges). Without LLM_API_KEY the agent says what to add.
LLM_API_KEY=
LLM_DEFAULT_MODEL=google/gemini-2.5-flash
LLM_MODELS=google/gemini-2.5-flash,google/gemini-2.5-pro
# LLM_VIDEO_REVIEWER_MODEL=google/gemini-2.5-flash
EMBEDDING_MODEL=google/gemini-embedding-001
CRON_SECRET=

# ── Demo login (printed by the `migrate` service) ─────────────────────────────────────────────
SEED_DEMO_EMAIL=demo@feega.local
SEED_DEMO_PASSWORD=feega-demo-2026
BILLING_PROVIDER=open
