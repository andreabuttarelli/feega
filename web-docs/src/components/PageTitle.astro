---
const { entry } = Astro.locals.starlightRoute;
const { title, description } = entry.data;
const isHome = entry.data.template === 'splash';
const section = entry.id.split('/')[0].replaceAll('-', ' ');
---

{
  !isHome && (
    <>
      <nav class="sx-crumbs" aria-label="Breadcrumb">
        <a href="/">docs</a>
        <span aria-hidden="true">/</span>
        <span>{section}</span>
      </nav>
      <h1 id="_top">{title}</h1>
      {description && <p class="page-lead">{description}</p>}
    </>
  )
}
