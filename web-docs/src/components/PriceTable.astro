<div class="price-table" data-price-table>
  <input type="search" placeholder="Filter by model, provider, kind or unit" aria-label="Filter models" />
  <p class="price-count" aria-live="polite"></p>
  <div class="price-scroll"><slot /></div>
</div>

<style>
  .price-table input {
    width: 100%;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 4px;
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-white);
  }
  .price-count {
    margin: 0.5rem 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .price-scroll {
    overflow-x: auto;
  }
  .price-table :global(th) {
    cursor: pointer;
    white-space: nowrap;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-price-table]');
  const table = root?.querySelector('table');
  const input = root?.querySelector('input');
  const count = root?.querySelector('.price-count');

  if (root && table && input && count) {
    const body = table.tBodies[0];
    const rows = Array.from(body.rows);
    const total = rows.length;

    const show = () => {
      const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      let visible = 0;
      for (const row of rows) {
        const text = row.textContent?.toLowerCase() ?? '';
        row.hidden = !terms.every((term) => text.includes(term));
        visible += row.hidden ? 0 : 1;
      }
      count.textContent = `${visible} of ${total} rows`;
    };

    const numberOf = (row: HTMLTableRowElement, column: number) => {
      const parsed = parseFloat(row.cells[column].textContent ?? '');
      return Number.isNaN(parsed) ? Infinity : parsed;
    };

    let sorted = { column: -1, direction: 1 };
    table.tHead?.querySelectorAll('th').forEach((th, column) => {
      th.addEventListener('click', () => {
        const direction = sorted.column === column ? -sorted.direction : 1;
        sorted = { column, direction };
        const numeric = th.textContent === 'Credits';
        const keyOf = (row: HTMLTableRowElement) => (numeric ? numberOf(row, column) : (row.cells[column].textContent ?? '').toLowerCase());
        rows.sort((a, b) => (keyOf(a) > keyOf(b) ? direction : keyOf(a) < keyOf(b) ? -direction : 0));
        body.append(...rows);
      });
    });

    input.addEventListener('input', show);
    show();
  }
</script>
