{
  "name": "feega",
  "displayName": "Feega",
  "description": "Open .feega canvases in your editor: motion video, UI and graphic design that your agent edits over MCP.",
  "version": "0.1.2",
  "publisher": "AndreaButtarelli",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/andreabuttarelli/feega",
    "directory": "vscode"
  },
  "homepage": "https://docs.feega.app/integrations/editor/",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Visualization",
    "AI",
    "Other"
  ],
  "keywords": [
    "design",
    "canvas",
    "motion",
    "video",
    "mcp",
    "figma",
    "agent"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:**/*.feega",
    "workspaceContains:.feega/**"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "feega.canvas",
        "displayName": "Feega canvas",
        "selector": [
          {
            "filenamePattern": "*.feega"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "feega.openProject",
        "title": "Open this folder as a project",
        "category": "Feega"
      },
      {
        "command": "feega.importFolder",
        "title": "Import this folder into a canvas",
        "category": "Feega"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "feega.local",
        "label": "Feega (local canvas)"
      }
    ],
    "configuration": {
      "title": "Feega",
      "properties": {
        "feega.devServerPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a local clone of the Feega repo. When set, the canvas runs that clone's `scripts/local.mjs` instead of `npx feega@latest`, to try unreleased code."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test canvas-run.test.js",
    "package": "npx -y @vscode/vsce package --no-dependencies",
    "test:e2e": "node test/run.js"
  },
  "galleryBanner": {
    "color": "#0b0b0c",
    "theme": "dark"
  },
  "bugs": {
    "url": "https://github.com/andreabuttarelli/feega/issues"
  }
}
