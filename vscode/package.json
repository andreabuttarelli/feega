{
  "name": "feega",
  "displayName": "Feega",
  "description": "Open .feega canvases in your editor: motion video, UI and graphic design that your agent edits over MCP.",
  "version": "0.1.2",
  "publisher": "AndreaButtarelli",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/andreabuttarelli/feega",
    "directory": "vscode"
  },
  "homepage": "https://docs.feega.app/integrations/editor/",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Visualization",
    "AI",
    "Other"
  ],
  "keywords": [
    "design",
    "canvas",
    "motion",
    "video",
    "mcp",
    "figma",
    "agent"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:**/*.feega"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "feega.canvas",
        "displayName": "Feega canvas",
        "selector": [
          {
            "filenamePattern": "*.feega"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "feega",
          "title": "Feega",
          "icon": "media/feega.svg"
        }
      ]
    },
    "views": {
      "feega": [
        {
          "id": "feega.home",
          "name": "Canvas"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "feega.home",
        "contents": "Open a folder to work on a canvas.\n[Open Folder](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      },
      {
        "view": "feega.home",
        "contents": "[Open canvas](command:feega.openCanvas)\n[New canvas](command:feega.newCanvas)",
        "when": "workbenchState != empty"
      }
    ],
    "commands": [
      {
        "command": "feega.openCanvas",
        "title": "Open canvas",
        "category": "Feega"
      },
      {
        "command": "feega.newCanvas",
        "title": "New canvas",
        "category": "Feega"
      },
      {
        "command": "feega.importFolder",
        "title": "Import this folder into a canvas",
        "category": "Feega"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "feega.local",
        "label": "Feega (local canvas)"
      }
    ]
  },
  "scripts": {
    "test": "node --test canvas-run.test.js home.test.js",
    "package": "npx -y @vscode/vsce package --no-dependencies",
    "test:e2e": "node test/run.js"
  },
  "galleryBanner": {
    "color": "#0b0b0c",
    "theme": "dark"
  },
  "bugs": {
    "url": "https://github.com/andreabuttarelli/feega/issues"
  }
}
