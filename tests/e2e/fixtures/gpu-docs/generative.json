  "Drop": {
   "source": {
    "html": "",
    "css": ":scope{background:#000;overflow:hidden} .b{position:absolute;left:0;top:0;will-change:transform;box-sizing:border-box} .floor{position:absolute;left:0;right:0;height:1px;background:rgba(245,245,245,0.25)}",
    "js": "const W = root.clientWidth || 1920, H = root.clientHeight || 1080, D = Math.min(W, H);\nconst engine = Matter.Engine.create();\nengine.gravity.y = 1.6;\nconst FLOOR = H - D * 0.12;\nconst floor = Matter.Bodies.rectangle(W / 2, FLOOR + 50, W * 3, 100, { isStatic: true });\nconst walls = [Matter.Bodies.rectangle(W * 0.12 - 50, H / 2, 100, H * 4, { isStatic: true }), Matter.Bodies.rectangle(W * 0.88 + 50, H / 2, 100, H * 4, { isStatic: true })];\nconst N = 46;\nconst spec = Array.from({ length: N }, (_, i) => ({ s: D * (0.05 + rand() * 0.07), round: rand() < 0.45, x: W * 0.16 + rand() * W * 0.68, y: -D * 0.1 - (i / N) * H * 0.9, look: rand() < 0.3 ? 'line' : 'solid' }));\nspec.push({ s: D * 0.2, round: true, x: W / 2, y: -H * 1.25, look: 'hot' });\nconst pieces = spec.map((p) => {\n  const body = p.round ? Matter.Bodies.circle(p.x, p.y, p.s / 2, { restitution: 0.3, friction: 0.5 }) : Matter.Bodies.rectangle(p.x, p.y, p.s, p.s, { restitution: 0.2, friction: 0.6, angle: rand() * Math.PI });\n  const el = document.createElement('div');\n  el.className = 'b';\n  el.style.width = p.s + 'px';\n  el.style.height = p.s + 'px';\n  el.style.borderRadius = p.round ? '50%' : '0';\n  el.style.background = p.look === 'hot' ? '#0099ff' : p.look === 'solid' ? '#f5f5f5' : 'transparent';\n  el.style.border = p.look === 'line' ? '2px solid #f5f5f5' : '0';\n  root.appendChild(el);\n  return { body, el, s: p.s };\n});\nconst ground = document.createElement('div');\nground.className = 'floor';\nground.style.top = FLOOR + 'px';\nroot.appendChild(ground);\nMatter.Composite.add(engine.world, [floor, ...walls, ...pieces.map((p) => p.body)]);\nconst at = Matter.seekable(engine);\ntl.to({}, { duration, ease: 'none', onUpdate() {\n  const poses = at(this.time());\n  for (const p of pieces) {\n    const pose = poses.get(p.body);\n    p.el.style.transform = 'translate(' + (pose.x - p.s / 2) + 'px,' + (pose.y - p.s / 2) + 'px) rotate(' + pose.angle + 'rad)';\n  }\n} }, 0);\nfx.grain(root, { opacity: 0.1, boil: 12 });"
