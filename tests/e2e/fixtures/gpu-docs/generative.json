   "source": {
    "html": "<canvas class=\"c\"></canvas>",
    "css": ":scope{background:#000} .c{position:absolute;inset:0;width:100%;height:100%}",
    "js": "const W = root.clientWidth || 1920, H = root.clientHeight || 1080, D = Math.min(W, H);\nconst clamp = (v) => Math.max(0, Math.min(1, v));\nconst cv = root.querySelector('.c');\ncv.width = W;\ncv.height = H;\nconst g = cv.getContext('2d');\nconst seeds = gen.poisson({ shape: [W * 1.1, H * 1.1], minDistance: D * 0.065, maxDistance: D * 0.11 }).fill().map(([x, y]) => [x - W * 0.05, y - H * 0.05]);\nconst noise = gen.noise3D();\nconst far = Math.hypot(W, H) / 2;\nconst rank = seeds.map(([x, y]) => Math.hypot(x - W / 2, y - H / 2) / far);\nconst hot = seeds.map(() => rand() < 0.06);\nconst ease = motion.parseEase('power3.out');\ntl.to({}, { duration, ease: 'none', onUpdate() {\n  const t = this.time();\n  const amp = D * 0.03 * (0.4 + 0.6 * ease(clamp(t / 2)));\n  const moved = seeds.map(([x, y]) => [x + noise(x / 420, y / 420, t * 0.3) * amp, y + noise(y / 420, x / 420, t * 0.3 + 7) * amp]);\n  const delaunay = gen.Delaunay.from(moved);\n  const voronoi = delaunay.voronoi([0, 0, W, H]);\n  g.fillStyle = '#000';\n  g.fillRect(0, 0, W, H);\n  const fill = ease(clamp((t - 1.5) / 0.7));\n  g.fillStyle = 'rgba(0, 153, 255, ' + fill + ')';\n  for (let i = 0; i < moved.length; i++) {\n    if (!hot[i]) { continue; }\n    g.beginPath();\n    voronoi.renderCell(i, g);\n    g.fill();\n  }\n  const reach = ease(clamp((t - 0.6) / 1.2)) * far * 1.05;\n  g.save();\n  g.beginPath();\n  g.arc(W / 2, H / 2, Math.max(0.1, reach), 0, Math.PI * 2);\n  g.clip();\n  g.strokeStyle = 'rgba(245, 245, 245, 0.32)';\n  g.lineWidth = 1.2;\n  g.beginPath();\n  delaunay.render(g);\n  g.stroke();\n  g.restore();\n  for (let i = 0; i < moved.length; i++) {\n    const r = ease(clamp((t - rank[i] * 0.8) / 0.4)) * D * 0.0055;\n    if (r <= 0) { continue; }\n    g.fillStyle = hot[i] ? '#0099ff' : '#f5f5f5';\n    g.beginPath();\n    g.arc(moved[i][0], moved[i][1], r, 0, Math.PI * 2);\n    g.fill();\n  }\n} }, 0);\nfx.grain(root, { opacity: 0.1, boil: 12 });"
   },
