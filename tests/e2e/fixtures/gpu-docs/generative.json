  "Data": {
   "source": {
    "html": "<svg class=\"s\"><g class=\"bars\"></g><path class=\"line\"></path><line class=\"base\"></line></svg>",
    "css": ":scope{background:#000} .s{position:absolute;inset:0;width:100%;height:100%} .line{fill:none;stroke:#f5f5f5;stroke-width:3} .base{stroke:#f5f5f5;stroke-opacity:0.25;stroke-width:1}",
    "js": "const W = root.clientWidth || 1920, H = root.clientHeight || 1080, D = Math.min(W, H);\nconst clamp = (v) => Math.max(0, Math.min(1, v));\nconst svg = d3.select(root.querySelector('.s')).attr('viewBox', '0 0 ' + W + ' ' + H);\nconst N = 40;\nconst noise = gen.noise2D();\nconst data = d3.range(N).map((i) => 0.25 + 0.45 * (i / (N - 1)) + 0.18 * noise(i * 0.22, 4));\nconst peak = d3.maxIndex(data);\nconst left = W * 0.1, right = W * 0.9, top = H * 0.18, bottom = H * 0.8;\nconst x = d3.scaleBand().domain(d3.range(N)).range([left, right]).padding(0.35);\nconst y = d3.scaleLinear().domain([0, 1]).range([bottom, top]);\nconst bars = svg.select('.bars').selectAll('rect').data(data).join('rect')\n  .attr('x', (_, i) => x(i)).attr('width', x.bandwidth())\n  .attr('fill', (_, i) => (i === peak ? '#0099ff' : '#f5f5f5')).attr('fill-opacity', (_, i) => (i === peak ? 1 : 0.85));\nsvg.select('.base').attr('x1', left).attr('x2', right).attr('y1', bottom).attr('y2', bottom);\nconst line = d3.line().x((_, i) => x(i) + x.bandwidth() / 2).y((d) => y(d) - D * 0.05).curve(d3.curveMonotoneX);\nconst path = root.querySelector('.line');\npath.setAttribute('d', line(data));\nconst ease = d3.easeCubicOut;\ntl.to({}, { duration, ease: 'none', onUpdate() {\n  const t = this.time();\n  bars.each(function (d, i) {\n    const k = ease(clamp((t - 0.1 - i * (1.1 / N)) / 0.7));\n    const h = (bottom - y(d)) * k;\n    this.setAttribute('y', bottom - h);\n    this.setAttribute('height', h);\n  });\n} }, 0);\nconst draw = motion.drawPath(path);\ntl.fromTo(draw, { draw: 0 }, { draw: 1, duration: 1.1, ease: 'power2.inOut' }, 1.1);\nfx.grain(root, { opacity: 0.1, boil: 12 });"
