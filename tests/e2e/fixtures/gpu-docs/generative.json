    "html": "",
    "css": ":scope{background:#000} canvas{position:absolute;inset:0}",
    "js": "const W = root.clientWidth || 1920, H = root.clientHeight || 1080, D = Math.min(W, H);\nconst N = Math.round(W * H / 2400), STEPS = 64, STEP = D / 170, GROW = 2.2;\nconst grow = motion.parseEase('power2.inOut');\np5((p) => {\n  p.setup = () => { p.createCanvas(W, H); p.pixelDensity(1); };\n  p.draw = () => {\n    const t = p.frameCount / fps;\n    p.background(0);\n    p.randomSeed(11);\n    p.noiseSeed(11);\n    const steps = Math.max(1, Math.floor(STEPS * grow(Math.min(1, t / GROW))));\n    const drift = t * 0.05;\n    p.noFill();\n    for (let i = 0; i < N; i++) {\n      let x = p.random(-0.05, 1.05) * W, y = p.random(-0.05, 1.05) * H;\n      const hot = p.random() < 0.05;\n      p.stroke(hot ? p.color(0, 153, 255, 235) : p.color(245, 245, 245, 64));\n      p.strokeWeight(hot ? 2.2 : 1.1);\n      p.beginShape();\n      for (let s = 0; s < steps; s++) {\n        p.vertex(x, y);\n        const a = p.noise(x * 0.0014, y * 0.0014, drift) * p.TWO_PI * 2;\n        x += Math.cos(a) * STEP;\n        y += Math.sin(a) * STEP;\n      }\n      p.endShape();\n    }\n  };\n});\nfx.grain(root, { opacity: 0.1, boil: 12 });"
