{
  "color": {
    "$type": "color",
    "blue": {
      "500": { "$value": "#1d4ed8" }
    },
    "primary": { "$value": "{color.blue.500}" },
    "surface": { "$value": "#ffffff" }
  },
  "spacing": {
    "$type": "dimension",
    "md": { "$value": "16px" },
    "lg": { "$value": { "value": 1.5, "unit": "rem" } }
  },
  "radius": {
    "card": { "$type": "dimension", "$value": "12px" }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Inter", "sans-serif"] }
    }
  },
  "shadow": {
    "card": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px", "color": "#0000001a" } }
  }
}
