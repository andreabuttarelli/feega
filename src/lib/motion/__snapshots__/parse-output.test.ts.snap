exports[`parseMotionDoc output > refuses every invalid fixture with the same error 1`] = `
{
  "empty keyframe track": "refused: tracks.0.clips.0.keyframes.opacity: Too small: expected array to have >=1 items",
  "frame rate not offered": "refused: fps: Invalid option: expected one of 24|25|30|50|60|120",
  "keyframes on a prop it cannot animate": "refused: Title cannot animate orbit; it animates: x, y, z, scale, scaleX, scaleY, rotateX, rotateY, rotateZ, skewX, skewY, perspective, opacity, blur, color, weight, tracking, leading, stretch, slant, maskX, maskY, maskWidth, maskHeight, maskRotation, maskFeather, maskExpansion, maskOpacity",
  "missing composition": "refused: no composition ghost: precompose clips first",
  "missing custom component": "refused: no custom component NodeGraph: write_component first",
  "negative start": "refused: tracks.0.clips.0.from: Too small: expected number to be >=0",
  "newer version": "refused: version: Invalid input: expected 5",
  "not an object": "refused: : Invalid input: expected object, received string",
  "null": "refused: : Invalid input: expected object, received null",
  "parent cycle": "refused: a → b: parenting would make a loop",
  "parent that does not exist": "refused: c1: the parent ghost must be a visual clip of this video",
  "side above the limit": "refused: width: Too big: expected number to be <=16384; : a frame takes 16 to 16384 px a side (a still design from 1); the video limits apply when it is exported",
  "still past the end": "refused: still: the still frame is past the end of the doc",
  "too long": "refused: durationInFrames: the video can be at most 180 seconds",
  "tracks not a list": "refused: tracks: Invalid input: expected array, received object",
  "unknown blend mode": "refused: tracks.0.clips.0.blend: Invalid option: expected one of "normal"|"multiply"|"screen"|"overlay"|"darken"|"lighten"|"color-dodge"|"color-burn"|"hard-light"|"soft-light"|"difference"|"exclusion"|"hue"|"saturation"|"color"|"luminosity"|"linear-burn"|"linear-dodge"|"vivid-light"|"linear-light"|"pin-light"|"hard-mix"|"subtract"|"divide"|"darker-color"|"lighter-color"",
  "unknown component": "refused: tracks.0.clips.0.component: Invalid option: expected one of "Title"|"Text"|"Kicker"|"Caption"|"Image"|"Video"|"Audio"|"Shape"|"Logo"|"Null"|"BrandBackground"|"ProductCard"|"SocialMockup"|"CanvasMock"|"Model3D"|"Shape3D"|"Text3D"|"Logo3D"|"Device3D"|"Composition"|"Particles"|"LiquidGlass"|"LiquidBlob"|"ShaderEffect"|"Precomp"|"Adjustment"|"Light"|"Custom"",
  "unknown font": "refused: font No Such Font Family is not in this video: call register_font with the family before adding the clip, or pick a built-in (sans, mono)",
}
`;
