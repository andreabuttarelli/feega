---
import '../styles/blog.css';
import { SITE_TITLE, SITE_DESCRIPTION, SOCIAL_PREVIEW } from '../site';

interface Props {
  title?: string;
  description?: string;
  cover?: { src: string; alt: string };
  type?: 'website' | 'article';
  jsonLd?: object;
}

const { title, description = SITE_DESCRIPTION, cover, type = 'website', jsonLd } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = cover ? new URL(cover.src, Astro.site).href : SOCIAL_PREVIEW.image;
const ogAlt = cover?.alt ?? SOCIAL_PREVIEW.alt;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/bdo-grotesk-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(SOCIAL_PREVIEW.width)} />
    <meta property="og:image:height" content={String(SOCIAL_PREVIEW.height)} />
    <meta property="og:image:alt" content={ogAlt} />
    {!cover && <meta property="og:video" content={SOCIAL_PREVIEW.video} />}
    {!cover && <meta property="og:video:secure_url" content={SOCIAL_PREVIEW.video} />}
    {!cover && <meta property="og:video:type" content="video/mp4" />}
    {!cover && <meta property="og:video:width" content={String(SOCIAL_PREVIEW.width)} />}
    {!cover && <meta property="og:video:height" content={String(SOCIAL_PREVIEW.height)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE_TITLE} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/"><img src="/favicon.svg" alt="" width="22" height="22" />Feega</a>
      <nav>
        <a href="https://feega.app">Product</a>
        <a href="https://docs.feega.app">Docs</a>
        <a href="https://github.com/andreabuttarelli/feega">GitHub</a>
        <a href="https://discord.gg/PUp37DG6vr">Discord</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>Try it: <code>npx feega</code></span>
      <span><a href="/rss.xml">RSS</a> · <a href="/tags/">Tags</a> · <a href="https://feega.app">feega.app</a></span>
    </footer>
  </body>
</html>
