---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { postsNewestFirst } from '../site';

const posts = await postsNewestFirst();
---

<Base>
  <header class="index-head">
    <nav class="sx-crumbs" aria-label="Breadcrumb"><span>blog</span></nav>
    <h1 class="page-title">Building Feega in public</h1>
    <p class="lede">Notes on design in your codebase, and the decisions behind Feega.</p>
    <div class="pills">
      <a class="sx-pill is-outline" href="/rss.xml">rss</a>
      <a class="sx-pill is-outline" href="/use-cases/">use cases</a>
      <a class="sx-pill is-outline" href="/tags/">tags</a>
    </div>
  </header>
  <PostList posts={posts} />
</Base>
