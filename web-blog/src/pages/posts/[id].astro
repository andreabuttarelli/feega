---
import Article from '../../layouts/Article.astro';
import { allPosts, postsNewestFirst, type Post } from '../../site';

export async function getStaticPaths() {
  const current = await postsNewestFirst();
  return (await allPosts()).map((post) => ({ params: { id: post.id }, props: { post, all: current } }));
}

const { post, all } = Astro.props as { post: Post; all: Post[] };
---

<Article post={post} all={all} />
