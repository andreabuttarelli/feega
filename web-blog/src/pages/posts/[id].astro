---
import Article from '../../layouts/Article.astro';
import { postsNewestFirst, type Post } from '../../site';

export async function getStaticPaths() {
  const posts = await postsNewestFirst();
  return posts.map((post) => ({ params: { id: post.id }, props: { post, all: posts } }));
}

const { post, all } = Astro.props as { post: Post; all: Post[] };
---

<Article post={post} all={all} />
