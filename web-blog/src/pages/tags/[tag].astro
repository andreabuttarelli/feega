---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { allNewestFirst, tagSlug, type Entry } from '../../site';

export async function getStaticPaths() {
  const posts = await allNewestFirst();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) }
  }));
}

const { tag, posts } = Astro.props as { tag: string; posts: Entry[] };
---

<Base title={`#${tag}`} description={`Feega posts tagged ${tag}.`}>
  <header class="index-head">
    <nav class="sx-crumbs" aria-label="Breadcrumb"><a href="/">blog</a><span aria-hidden="true">/</span><span>tags</span></nav>
    <h1 class="page-title">#{tag}</h1>
  </header>
  <PostList posts={posts} />
</Base>
