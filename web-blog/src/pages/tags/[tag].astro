---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { postsNewestFirst, tagSlug, type Post } from '../../site';

export async function getStaticPaths() {
  const posts = await postsNewestFirst();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) }
  }));
}

const { tag, posts } = Astro.props as { tag: string; posts: Post[] };
---

<Base title={`#${tag}`} description={`Feega posts tagged ${tag}.`}>
  <h1 class="page-title">#{tag}</h1>
  <PostList posts={posts} />
</Base>
