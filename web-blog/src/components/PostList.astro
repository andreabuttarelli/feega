---
import { formatDate, readingMinutes, SECTIONS, type Entry, type Section } from '../site';

interface Props {
  posts: Entry[];
  section?: Section;
}

const { posts, section = 'posts' } = Astro.props;
const { path } = SECTIONS[section];
---

<ol class="post-list">
  {
    posts.map((post) => (
      <li class="post-item">
        <a href={`${path}${post.id}/`}>
          <img src={post.data.cover} alt="" width="1200" height="630" loading="lazy" />
          <div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <p class="meta">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> · {readingMinutes(post)} min read
            </p>
          </div>
        </a>
      </li>
    ))
  }
</ol>
