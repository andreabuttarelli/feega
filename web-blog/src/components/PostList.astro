---
import { formatDate, readingMinutes, sectionOf, SECTIONS, type Entry } from '../site';

interface Props {
  posts: Entry[];
}

const { posts } = Astro.props;
---

<ol class="post-list">
  {
    posts.map((post) => (
      <li class="post-item">
        <a href={`${SECTIONS[sectionOf(post)].path}${post.id}/`}>
          <img src={post.data.cover} alt="" width="1200" height="630" loading="lazy" />
          <div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <p class="meta">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> · {readingMinutes(post)} min read
            </p>
          </div>
        </a>
      </li>
    ))
  }
</ol>
