---
import { formatDate, readingMinutes, type Post } from '../site';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ol class="post-list">
  {
    posts.map((post) => (
      <li>
        <a href={`/posts/${post.id}/`}>
          <img src={post.data.cover} alt="" width="160" height="84" loading="lazy" />
          <div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <p class="meta">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> · {readingMinutes(post)} min read
            </p>
          </div>
        </a>
      </li>
    ))
  }
</ol>
