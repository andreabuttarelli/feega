{
  "installCommand": "npm ci",
  "ignoreCommand": "bash scripts/vercel-ignore.sh . ':!docs' ':!supabase' ':!landing' ':!web-docs' ':!web-blog'",
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/v1/billing/seats/reconcile",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/v1/cloud/digest/tick",
      "schedule": "*/15 * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
