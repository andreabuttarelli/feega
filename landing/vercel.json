{
  "ignoreCommand": "bash ../scripts/vercel-ignore.sh . ../src/lib/content/changelog",
  "headers": [
    {
      "source": "/_app/immutable/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/site/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/install",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/x-shellscript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/(llms.txt|llms-full.txt|sitemap.xml|robots.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "redirects": [
    {
      "source": "/refunds",
      "destination": "/terms#refunds",
      "statusCode": 301
    },
    {
      "source": "/:page(acceptable-use|ai-transparency|dpa|subprocessors|legal-notice)",
      "destination": "/terms",
      "statusCode": 301
    },
    {
      "source": "/:page(ai-video-generator|ai-video-styles|claymation-ai|3d-animation-maker|ai-commercial-maker|paper-cutout-animation|80s-retro-video|anime-video-generator|spotify-canvas-maker|ai-video-upscaler)",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/ai-node-editor",
      "destination": "/design-in-your-codebase",
      "statusCode": 301
    },
    {
      "source": "/guides",
      "destination": "/alternatives",
      "statusCode": 301
    },
    {
      "source": "/guides/:path*",
      "destination": "/alternatives",
      "statusCode": 301
    },
    {
      "source": "/download/mac",
      "destination": "/download",
      "statusCode": 301
    },
    {
      "source": "/guides/best-motion-design-tools-ai-agents",
      "destination": "/alternatives",
      "statusCode": 301
    },
    {
      "source": "/blog/how-the-canvas-got-fast",
      "destination": "https://blog.feega.app/posts/how-the-canvas-got-fast/",
      "statusCode": 301
    },
    {
      "source": "/compare",
      "destination": "/alternatives",
      "statusCode": 301
    },
    {
      "source": "/compare/:tool(figma)",
      "destination": "/alternatives/figma",
      "statusCode": 301
    },
    {
      "source": "/compare/:tool(pencil-dev|canva|flora|gui|jitter|remotion|after-effects|rive)",
      "destination": "/alternatives",
      "statusCode": 301
    },
    {
      "source": "/blog/feega-vs-:tool(figma)",
      "destination": "/alternatives/figma",
      "statusCode": 301
    },
    {
      "source": "/blog/feega-vs-:tool",
      "destination": "/alternatives",
      "statusCode": 301
    },
    {
      "source": "/blog",
      "destination": "/alternatives",
      "statusCode": 301
    },
    {
      "source": "/blog/:path*",
      "destination": "https://blog.feega.app/",
      "statusCode": 301
    }
  ]
}
