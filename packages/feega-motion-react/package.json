{
  "name": "@feega/motion-react",
  "version": "0.1.0",
  "description": "Embed an interactive feega motion video in a React app: the hosted player, wired to scroll, visibility and your callbacks.",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/andreabuttarelli/feega.git", "directory": "packages/feega-motion-react" },
  "homepage": "https://feega.app",
  "keywords": ["feega", "motion", "video", "embed", "react", "scroll"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
      "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
