{
  "id": "feega.gradient-presets",
  "name": "Gradient presets",
  "version": "1.0.0",
  "permissions": [
    "selection",
    "edit.style"
  ],
  "contributions": {
    "addMenu": [
      {
        "id": "presets",
        "title": "Gradient preset",
        "popover": "presets"
      }
    ],
    "popover": [
