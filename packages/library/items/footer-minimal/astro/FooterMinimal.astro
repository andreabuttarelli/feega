<style>
.fl-footer-minimal{font-family:var(--feega-font);font-size:var(--feega-text-body);line-height:1.5;letter-spacing:var(--feega-tracking);color:var(--feega-fg);background:var(--feega-bg);-webkit-font-smoothing:antialiased}
:where(.fl-footer-minimal) *,:where(.fl-footer-minimal) *::before,:where(.fl-footer-minimal) *::after{box-sizing:border-box}
:where(.fl-footer-minimal) :is(h1,h2,h3,h4,p,ul,ol,figure,blockquote,dl,dd){margin:0}
:where(.fl-footer-minimal) a{color:inherit;text-decoration:none}
:where(.fl-footer-minimal) :focus-visible{outline:2px solid var(--feega-focus);outline-offset:3px}
.fl-container{width:min(var(--feega-max-width),100% - 2 * var(--feega-gutter));margin-inline:auto}
.fl-px{display:block;flex:none;width:1em;height:auto;fill:currentColor;shape-rendering:crispEdges}
.fl-footer-minimal{border-top:1px solid var(--feega-line)}
.fl-footer-minimal .row{display:flex;flex-wrap:wrap;align-items:center;gap:var(--feega-space-3) var(--feega-space-8);min-height:64px;padding-block:var(--feega-space-4);font-size:var(--feega-text-sm);color:var(--feega-fg-muted)}
.fl-footer-minimal .brand{display:inline-flex;align-items:center;gap:8px}
.fl-footer-minimal .brand .fl-px{width:11px;color:var(--feega-accent)}
.fl-footer-minimal nav{display:flex;flex-wrap:wrap;gap:var(--feega-space-4)}
.fl-footer-minimal nav a:hover{color:var(--feega-fg)}
.fl-footer-minimal .status{display:inline-flex;align-items:center;gap:8px;margin-left:auto;font-family:var(--feega-font-mono);font-size:var(--feega-text-xs);text-transform:uppercase}
.fl-footer-minimal .status i{width:7px;height:7px;border-radius:var(--feega-radius-full);background:var(--feega-success)}
@media (max-width:560px){.fl-footer-minimal .status{margin-left:0}}
@media (prefers-reduced-motion:reduce){:where([class^="fl-"]) *,:where([class^="fl-"]) *::before,:where([class^="fl-"]) *::after{animation:none!important;transition:none!important}}
</style>
