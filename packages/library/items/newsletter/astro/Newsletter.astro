<section class="fl-newsletter">
  <div class="fl-container card">
    <div class="copy">
      <span class="ic"><svg class="fl-px" viewBox="0 0 8 6" aria-hidden="true"><path d="M0 0h1v1h-1zM1 0h1v1h-1zM2 0h1v1h-1zM3 0h1v1h-1zM4 0h1v1h-1zM5 0h1v1h-1zM6 0h1v1h-1zM7 0h1v1h-1zM0 1h1v1h-1zM1 1h1v1h-1zM6 1h1v1h-1zM7 1h1v1h-1zM0 2h1v1h-1zM2 2h1v1h-1zM5 2h1v1h-1zM7 2h1v1h-1zM0 3h1v1h-1zM3 3h1v1h-1zM4 3h1v1h-1zM7 3h1v1h-1zM0 4h1v1h-1zM7 4h1v1h-1zM0 5h1v1h-1zM1 5h1v1h-1zM2 5h1v1h-1zM3 5h1v1h-1zM4 5h1v1h-1zM5 5h1v1h-1zM6 5h1v1h-1zM7 5h1v1h-1z" /></svg></span>
      <h2>one useful email a month</h2>
      <p>What shipped, what we learned, nothing else.</p>
    </div>
    <form action="#">
      <label class="sr" for="fl-newsletter-email">Email</label>
      <div class="row"><input class="fl-input" id="fl-newsletter-email" type="email" placeholder="you@example.com" autocomplete="email" required /><button class="fl-btn fl-btn--primary" type="submit">subscribe</button></div>
      <small>No spam. Unsubscribe in one click.</small>
    </form>
  </div>
</section>

<style>
.fl-newsletter{font-family:var(--feega-font);font-size:var(--feega-text-body);line-height:1.5;letter-spacing:var(--feega-tracking);color:var(--feega-fg);background:var(--feega-bg);-webkit-font-smoothing:antialiased}
:where(.fl-newsletter) *,:where(.fl-newsletter) *::before,:where(.fl-newsletter) *::after{box-sizing:border-box}
:where(.fl-newsletter) :is(h1,h2,h3,h4,p,ul,ol,figure,blockquote,dl,dd){margin:0}
:where(.fl-newsletter) a{color:inherit;text-decoration:none}
:where(.fl-newsletter) :focus-visible{outline:2px solid var(--feega-focus);outline-offset:3px}
.fl-container{width:min(var(--feega-max-width),100% - 2 * var(--feega-gutter));margin-inline:auto}
.fl-px{display:block;flex:none;width:1em;height:auto;fill:currentColor;shape-rendering:crispEdges}
.fl-btn{display:inline-flex;align-items:center;justify-content:center;gap:var(--feega-space-2);min-height:44px;padding:0 var(--feega-space-6);border:1px solid var(--feega-line-strong);border-radius:var(--feega-radius-full);background:transparent;color:var(--feega-fg);font:inherit;font-size:0.9375rem;font-weight:500;letter-spacing:var(--feega-tracking);white-space:nowrap;text-decoration:none;cursor:pointer;transition:background-color var(--feega-dur-fast) var(--feega-ease),border-color var(--feega-dur-fast) var(--feega-ease),color var(--feega-dur-fast) var(--feega-ease),transform var(--feega-dur-fast) var(--feega-ease)}
.fl-btn:hover{border-color:var(--feega-fg-subtle);background:var(--feega-surface)}
.fl-btn:active{transform:scale(0.97)}
.fl-btn--primary{border-color:var(--feega-accent);background:var(--feega-accent);color:var(--feega-accent-fg)}
.fl-btn--primary:hover{border-color:var(--feega-accent-hover);background:var(--feega-accent-hover)}
.fl-btn--ink{border-color:var(--feega-fg);background:var(--feega-fg);color:var(--feega-bg)}
.fl-btn--ink:hover{border-color:var(--feega-fg-muted);background:var(--feega-fg-muted)}
.fl-btn--ghost{border-color:transparent}
.fl-btn--sm{min-height:36px;padding:0 var(--feega-space-4);font-size:var(--feega-text-sm)}
.fl-btn .fl-px{width:10px;transition:transform var(--feega-dur) var(--feega-ease)}
.fl-btn:hover .fl-px{transform:translateX(3px)}
.fl-btn[disabled]{opacity:0.45;cursor:not-allowed}
.fl-field{display:grid;gap:var(--feega-space-2);font-size:var(--feega-text-sm);font-weight:500}
.fl-input{width:100%;min-height:44px;padding:0 var(--feega-space-4);border:1px solid var(--feega-line);border-radius:var(--feega-radius-md);background:var(--feega-input);color:var(--feega-fg);font:inherit;font-size:var(--feega-text-body);font-weight:400;letter-spacing:var(--feega-tracking);transition:border-color var(--feega-dur-fast) var(--feega-ease),box-shadow var(--feega-dur-fast) var(--feega-ease)}
.fl-input::placeholder{color:var(--feega-fg-subtle)}
.fl-input:hover{border-color:var(--feega-line-strong)}
.fl-input:focus{outline:none;border-color:var(--feega-accent);box-shadow:0 0 0 4px var(--feega-accent-soft)}
.fl-newsletter{padding-block:var(--feega-space-16)}
.fl-newsletter .card{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:center;gap:var(--feega-space-8);padding:clamp(1.5rem,5vw,3.5rem);border-radius:var(--feega-radius-lg);background:var(--feega-surface)}
.fl-newsletter .copy{display:grid;justify-items:start;gap:var(--feega-space-3)}
.fl-newsletter .ic{display:grid;place-items:center;width:44px;height:44px;margin-bottom:var(--feega-space-2);border-radius:var(--feega-radius-md);background:var(--feega-accent);color:var(--feega-accent-fg)}
.fl-newsletter .ic .fl-px{width:18px}
.fl-newsletter h2{font-size:clamp(2rem,4vw,3rem);font-weight:500;line-height:0.95;letter-spacing:var(--feega-tracking-tight);text-wrap:balance}
.fl-newsletter p{color:var(--feega-fg-muted)}
.fl-newsletter form{display:grid;gap:var(--feega-space-3)}
.fl-newsletter .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
.fl-newsletter .row{display:flex;gap:var(--feega-space-2)}
.fl-newsletter .row .fl-input{flex:1;min-width:0;border-radius:var(--feega-radius-full)}
.fl-newsletter small{color:var(--feega-fg-subtle);font-size:var(--feega-text-xs)}
@media (max-width:820px){.fl-newsletter .card{grid-template-columns:minmax(0,1fr)}}
@media (max-width:420px){.fl-newsletter .row{flex-direction:column}}
@media (prefers-reduced-motion:reduce){:where([class^="fl-"]) *,:where([class^="fl-"]) *::before,:where([class^="fl-"]) *::after{animation:none!important;transition:none!important}}
</style>
