---
---

<div class="fl-ascii-pride" data-preset="rainbow" data-preset-options="rainbow,progress,intersex,trans,bisexual,pansexual,lesbian,nonbinary,asexual,aromantic,genderfluid,agender,mlm,polyamorous,demisexual,genderqueer,custom" data-speed="1" data-cell="14" data-fade="on" data-fade-options="on,off" aria-hidden="true">
  <canvas></canvas>
  <div class="fade"></div>
</div>

<script>
const RAMP = ' .:-=+*#%@';
const MAX_COLORS = 14;
const MAX_CELLS = 12000;
const LOOP_MS = 24000;
const FRAME_MS = 1000 / 30;
const MAX_DPR = 2;
const DEFAULT_CELL = 14;
const MOBILE_CELL = 11;
const MOBILE_MAX = 810;
const SCALE = 0.09;
const EDGE_FLOOR = 0.6;
const TINT_STEPS = 96;
const MIN_PEAK = 200;
const DARK_PEAK = 60;
const BAND_X = 0.55;
const BAND_Y = 0.35;
const TAU = Math.PI * 2;
const WAVES = [
  { kx: 0.11, ky: 0.07, r: 1.6, off: 0 },
  { kx: -0.06, ky: 0.13, r: 1.2, off: 1.7 },
  { kx: 0.04, ky: -0.09, r: 2.1, off: 3.1 }
];

type Rgb = number[];

function fieldAt(x: number, y: number, phase: number): number {
  const a = phase * TAU;
  const cx = Math.cos(a);
  const sy = Math.sin(a);
  let sum = 0;

  for (const w of WAVES) {
    const warp = Math.sin(y * 0.05 + w.r * sy + w.off) * 2;
    sum += Math.sin((x + warp) * w.kx + y * w.ky + w.r * cx + w.off);
  }

  return (sum / WAVES.length + 1) / 2;
}

function envelope(nx: number, ny: number): number {
  const r = Math.min(1, Math.hypot((nx - 0.5) * 2, (ny - 0.5) * 2) / Math.SQRT2);
  return 1 - r * r * (3 - 2 * r);
}

function glyphFor(density: number): string {
  return RAMP[Math.round(Math.min(1, Math.max(0, density)) * (RAMP.length - 1))];
}

function gridSize(width: number, height: number, cell: number) {
  let size = cell;
  while (Math.ceil(width / size) * Math.ceil(height / size) > MAX_CELLS) {
    size += 1;
  }

  return { cols: Math.ceil(width / size), rows: Math.ceil(height / size), cell: size };
}

function lifted(rgb: Rgb): Rgb {
  const gain = Math.max(1, MIN_PEAK / Math.max(...rgb, 1));
  return rgb.map((v) => Math.min(255, Math.round(v * gain)));
}

function toHex(rgb: Rgb): string {
  return '#' + rgb.map((v) => v.toString(16).padStart(2, '0')).join('');
}

function readStops(root: HTMLElement, probe: CanvasRenderingContext2D): Rgb[] {
  const style = getComputedStyle(root);
  const stops: Rgb[] = [];

  for (let i = 1; i <= MAX_COLORS; i++) {
    const value = style.getPropertyValue('--ascii-c' + i).trim();
    if (!value) {
      continue;
    }

    probe.fillStyle = 'transparent';
    probe.fillStyle = value;
    const hex = String(probe.fillStyle);
    if (hex.length !== 7) {
      continue;
    }

    const rgb = [1, 3, 5].map((k) => parseInt(hex.slice(k, k + 2), 16));
    if (Math.max(...rgb) > DARK_PEAK) {
      stops.push(rgb);
    }
  }

  return stops.length ? stops : [[255, 255, 255]];
}

function tints(stops: Rgb[]): string[] {
  return Array.from({ length: TINT_STEPS }, (_, s) => {
    const p = (s / TINT_STEPS) * stops.length;
    const i = Math.floor(p);
    const f = p - i;
    const a = stops[i % stops.length];
    const b = stops[(i + 1) % stops.length];
    return toHex(lifted(a.map((v, k) => v + (b[k] - v) * f)));
  });
}

function asciiPride(root: HTMLElement): () => void {
  const canvas = root.querySelector<HTMLCanvasElement>('canvas')!;
  const ctx = canvas.getContext('2d');
  if (!ctx) {
    return () => {};
  }

  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const t0 = performance.now();
  let grid = { cols: 0, rows: 0, cell: DEFAULT_CELL };
  let colours: string[] = [];
  let speed = 1;
  let visible = true;
  let raf = 0;
  let last = 0;

  function configure() {
    const dpr = Math.min(devicePixelRatio || 1, MAX_DPR);
    const width = root.clientWidth;
    const height = root.clientHeight;
    const cell = Number(root.dataset.cell) || (width < MOBILE_MAX ? MOBILE_CELL : DEFAULT_CELL);
    speed = Number(root.dataset.speed) || 0;
    canvas.width = Math.round(width * dpr);
    canvas.height = Math.round(height * dpr);
    grid = gridSize(width, height, cell);
    colours = tints(readStops(root, ctx!));
    ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx!.font = grid.cell + 'px ' + getComputedStyle(root).fontFamily;
    ctx!.textAlign = 'center';
    ctx!.textBaseline = 'middle';
  }

  function draw(now: number) {
    const clock = still ? 0 : ((now - t0) * speed) / LOOP_MS;
    const phase = clock - Math.floor(clock);
    const { cols, rows, cell } = grid;
    ctx!.clearRect(0, 0, canvas.width, canvas.height);

    for (let c = 0; c < cols; c++) {
      const nx = (c + 0.5) / cols;

      for (let r = 0; r < rows; r++) {
        const ny = (r + 0.5) / rows;
        const e = envelope(nx, ny);
        const d = Math.sqrt(fieldAt(c * cell * SCALE, r * cell * SCALE, phase)) * (EDGE_FLOOR + (1 - EDGE_FLOOR) * e);
        const glyph = glyphFor(d);
        if (glyph === ' ') {
          continue;
        }

        const band = nx * BAND_X + ny * BAND_Y + d * 0.2 - phase;
        ctx!.fillStyle = colours[Math.floor((band - Math.floor(band)) * TINT_STEPS) % TINT_STEPS];
        ctx!.globalAlpha = 0.35 + d * 0.6;
        ctx!.fillText(glyph, c * cell + cell / 2, r * cell + cell / 2);
      }
    }
  }

  function tick(now: number) {
    raf = requestAnimationFrame(tick);
    if (now - last < FRAME_MS) {
      return;
    }

    last = now;
    draw(now);
  }

  function sync() {
    cancelAnimationFrame(raf);
    if (still || !speed || !visible || document.hidden) {
      return;
    }

    raf = requestAnimationFrame(tick);
  }

  function refresh() {
    configure();
    draw(performance.now());
    sync();
  }

  const io = new IntersectionObserver(([entry]) => {
    visible = entry.isIntersecting;
    sync();
  });
  const ro = new ResizeObserver(refresh);
  const mo = new MutationObserver(refresh);

  refresh();
  canvas.classList.add('on');
  io.observe(root);
  ro.observe(root);
  mo.observe(root, { attributes: true, attributeFilter: ['data-preset', 'data-speed', 'data-cell', 'style', 'class'] });
  document.addEventListener('visibilitychange', sync);

  return () => {
    cancelAnimationFrame(raf);
    io.disconnect();
    ro.disconnect();
    mo.disconnect();
    document.removeEventListener('visibilitychange', sync);
  };
}

document.querySelectorAll<HTMLElement>('.fl-ascii-pride:not([data-ready])').forEach((root) => {
  root.setAttribute('data-ready', '');
  asciiPride(root);
});
</script>

<style is:global>
.fl-ascii-pride{font-family:var(--feega-font);font-size:var(--feega-text-body);line-height:1.5;letter-spacing:var(--feega-tracking);color:var(--feega-fg);background:var(--feega-bg);-webkit-font-smoothing:antialiased}
:where(.fl-ascii-pride) *,:where(.fl-ascii-pride) *::before,:where(.fl-ascii-pride) *::after{box-sizing:border-box}
:where(.fl-ascii-pride) :is(h1,h2,h3,h4,p,ul,ol,figure,blockquote,dl,dd){margin:0}
:where(.fl-ascii-pride) a{color:inherit;text-decoration:none}
:where(.fl-ascii-pride) :focus-visible{outline:2px solid var(--feega-focus);outline-offset:3px}
.fl-ascii-pride{--ascii-c1:initial;--ascii-c2:initial;--ascii-c3:initial;--ascii-c4:initial;--ascii-c5:initial;--ascii-c6:initial;--ascii-c7:initial;--ascii-c8:initial;--ascii-c9:initial;--ascii-c10:initial;--ascii-c11:initial;--ascii-c12:initial;--ascii-c13:initial;--ascii-c14:initial;position:relative;display:block;overflow:hidden;width:100%;height:100%;min-height:clamp(24rem,50vw,100svh);font-family:var(--feega-font-mono);contain:layout paint}
.fl-ascii-pride canvas{position:absolute;inset:0;display:block;width:100%;height:100%;opacity:0;transition:opacity 1.6s var(--feega-ease)}
.fl-ascii-pride canvas.on{opacity:1}
.fl-ascii-pride .fade{position:absolute;inset:0;pointer-events:none;background:linear-gradient(to bottom,transparent 55%,var(--feega-bg))}
.fl-ascii-pride[data-fade="off"] .fade{display:none}
.fl-ascii-pride[data-preset="rainbow"]{--ascii-c1:#E40303;--ascii-c2:#FF8C00;--ascii-c3:#FFED00;--ascii-c4:#008026;--ascii-c5:#004DFF;--ascii-c6:#750787}
.fl-ascii-pride[data-preset="progress"]{--ascii-c1:#000000;--ascii-c2:#613915;--ascii-c3:#74D7EE;--ascii-c4:#FFAFC8;--ascii-c5:#FFFFFF;--ascii-c6:#E40303;--ascii-c7:#FF8C00;--ascii-c8:#FFED00;--ascii-c9:#008026;--ascii-c10:#004DFF;--ascii-c11:#750787}
