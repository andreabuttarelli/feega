{
  "name": "feega-desktop",
  "productName": "feega",
  "private": true,
  "version": "0.1.0",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build": "electron-builder --publish never",
    "build:mac": "electron-builder --mac dir --publish never"
  },
  "build": {
    "appId": "app.feega.desktop",
    "productName": "feega",
    "files": [
      "main.cjs",
      "routing.cjs",
      "updates.cjs",
      "chrome.cjs"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "protocols": [
      {
        "name": "feega",
        "schemes": [
          "feega"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "notarize": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/andreabuttarelli/feega/releases/download/desktop-latest"
      }
    ],
    "artifactName": "feega-${version}-${os}-${arch}.${ext}"
  },
  "devDependencies": {
    "electron": "38.2.0",
    "electron-builder": "26.0.12"
  },
  "author": "feega <hello@feega.app>",
  "homepage": "https://feega.app",
  "description": "feega desktop",
  "dependencies": {
    "electron-updater": "6.6.2"
  }
}
