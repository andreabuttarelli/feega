{
  "name": "feega-desktop",
  "productName": "Feega",
  "private": true,
  "version": "0.1.0",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build": "electron-builder --publish never",
    "build:mac": "npm run build:mac:arm64 && npm run build:mac:x64",
    "build:native": "node scripts/build-native.cjs",
    "build:native:universal": "node scripts/build-native.cjs --universal",
    "start:native": "FEEGA_NATIVE_CANVAS=1 electron .",
    "stage:server": "node scripts/stage-server.cjs",
    "build:mac:arm64": "node scripts/stage-server.cjs --arch=arm64 && electron-builder --mac --arm64 --publish never",
    "build:mac:x64": "node scripts/stage-server.cjs --arch=x64 && electron-builder --mac --x64 --publish never"
  },
  "build": {
    "appId": "app.feega.desktop",
    "productName": "Feega",
    "files": [
      "main.cjs",
      "routing.cjs",
      "updates.cjs",
      "files.cjs",
      "server.cjs",
      "chrome.cjs"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "protocols": [
      {
        "name": "feega",
        "schemes": [
          "feega"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "hardenedRuntime": false,
      "notarize": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics"
    },
    "artifactName": "feega-${version}-${os}-${arch}.${ext}",
    "fileAssociations": [
      {
        "ext": "feega",
        "name": "feega canvas",
        "role": "Editor",
        "rank": "Owner"
      }
    ],
    "afterPack": "scripts/after-pack.cjs"
  },
  "devDependencies": {
    "electron": "38.2.0",
    "electron-builder": "26.0.12"
  },
  "author": "feega <hello@feega.app>",
  "homepage": "https://feega.app",
  "description": "feega desktop"
}
